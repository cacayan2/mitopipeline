"""
Snakefile

Top-level Snakemake file for the pipeline. 
"""

# Imports
from pathlib import Path
import pandas as pd

# Setting wildcard constraints - wildcard can match any sequence of one or or more characters 
# except the forward slash. 
wildcard_constraints:
    sample = r"[^/]+"

# Setting a bunch of variables from the config file.
PROJECT_ROOT = Path(workflow.basedir).parent.resolve()
SRC_DIR = PROJECT_ROOT / "src"

# Every rule invokes its exec script via THIS exact interpreter, never
# bare "python" -- confirmed by a real failure: a rule's own tool conda
# env (blastn/mitos2/GetOrganelle/etc, each a DIFFERENT, older Python)
# gets prepended ahead of this project's own venv on PATH, so bare
# "python" silently resolved to one of those instead and crashed on
# "from __future__ import annotations" (a Python 2/very-old-3 error).
# The project's own venv is the only interpreter with mitopipeline
# itself installed, regardless of which tool env is active for the
# external binary a given rule also needs on PATH.
#
# Deliberately NOT .resolve()'d -- confirmed by a second real failure:
# .venv/bin/python is itself a symlink to the system python3, and
# Python's own venv activation depends on being invoked through THAT
# symlink path (it looks for a sibling pyvenv.cfg next to the path it
# was actually invoked as) -- resolving the symlink first silently
# invokes the bare system interpreter instead, with no venv
# site-packages at all (biopython and everything else installed
# there became unimportable).
PYTHON_BIN = str(PROJECT_ROOT / ".venv" / "bin" / "python")

# Setting a shell prefix such that the source directory is included in the PATH.
shell.prefix(f'export PYTHONPATH="{SRC_DIR}:$PYTHONPATH"; ')

# Setting the output root and verifying that it is configured correctly. 
OUTPUT_ROOT_VALUE = config.get("output_root")
if not OUTPUT_ROOT_VALUE: raise ValueError("'output_root' must be set in the config file.")
OUTPUT_ROOT = Path(OUTPUT_ROOT_VALUE)

# Setting the job id and verifying that it is configured correctly in the runtime config.
JOB_ID = config.get("job_id")
if not JOB_ID: raise ValueError("'job_id' must be set in the runtime config file - use the pipeline launcher.")

# Obtaining remaining data from config.
JOB_DIR = OUTPUT_ROOT / JOB_ID
STAGES = config.get("stages", {})

# The whole-pipeline log every stage's logger also writes to, in
# addition to its own per-step log file. Same path PipelineJob itself
# uses (global_log_file_path) -- not a v0.1.0 convention, this is new
# v0.2.0 infrastructure (logger_factory.make_logger) that was built
# but never actually wired through to the Snakemake rule layer.
GLOBAL_LOG_FILE = JOB_DIR / "logs" / "00-job" / f"{JOB_ID}.global.log"

# Either uses runtime_manifest or manifest value, whichever one is available (runtime_manifest is preferred).
RUNTIME_MANIFEST_PATH = Path(config.get("runtime_manifest", config.get("manifest"))).expanduser().resolve()
if not RUNTIME_MANIFEST_PATH.exists(): raise FileNotFoundError(f"Runtime manifest not found: {RUNTIME_MANIFEST_PATH}")

# Loading the sample table.
SAMPLE_TABLE = pd.read_csv(
    RUNTIME_MANIFEST_PATH,
    sep = "\t",
    dtype = str,
    keep_default_na = False
)
if "sample_id" not in SAMPLE_TABLE.columns: raise ValueError("Runtime manifest must include a 'sample_id' column.")
SAMPLE_TABLE = SAMPLE_TABLE.set_index("sample_id", drop = False)
SAMPLES = SAMPLE_TABLE.index.tolist()

# Maps each numbered pipeline stage (used throughout this file and
# ctrl/rules/ for target/include naming) to the path of keys that
# actually toggle it in config.yaml's own "stages:" block -- that
# block uses coarser, human-facing names (e.g. one "assembly" toggle
# covers 04a/04c/04d; "assembly_post" nests contig_selection and
# assembly_rescue as separate toggles), never the numbered names
# themselves. A stage with no entry here is assumed to share its own
# name with the config key directly.
_STAGE_CONFIG_KEYS: dict[str, tuple[str, ...]] = {
    "01-qc_raw": ("qc_raw",),
    "02-trimming": ("trimming",),
    "03-qc_trimmed": ("qc_trimmed",),
    "04a-getorganelle_config": ("assembly",),
    "04c-seed_sequences": ("assembly",),
    "04d-assembly": ("assembly",),
    "05a-blast_config": ("blast",),
    "05b-blast": ("blast",),
    "05c-blast_hits": ("blast",),
    "06-contig_selection": ("assembly_post", "contig_selection"),
    "07-assembly_rescue": ("assembly_post", "assembly_rescue"),
    "08a-mitos2_config": ("annotation",),
    "08b-annotation": ("annotation",),
    "09-visualization": ("visualization",),
    "10-alignment_dataset": ("phylogeny",),
    "11-phylogeny": ("phylogeny",),
    "12a-stats_aggregation": ("reporting",),
    "12b-data_aggregation": ("reporting",),
    "13-report_pdf": ("pdf_export",),
    "14a-sra_archival": ("sra_archival",),
    "14b-biosample_archival": ("biosample_archival",),
    "14c-mitogenome_archival": ("mitogenome_archival",),
    "15-archival_validation": ("archival_validation",),
    "16-table2asn_validation": ("table2asn_validation",),
}

def stage_enabled(stage_name: str) -> bool:
    """
    Determine from the config whether a configured stage is enabled.

    Args:
        stage_name (str): The numbered stage name (e.g. "04d-assembly").

    Returns:
        bool: True if the stage is enabled, False otherwise.
    """
    value = STAGES
    for key in _STAGE_CONFIG_KEYS.get(stage_name, (stage_name,)):
        if not isinstance(value, dict):
            return False
        value = value.get(key, False)
    return bool(value)

def sample_target(stage: str, filename: str) -> list[str]:
    """
    Every rule created has targets which in essence is are paths. These paths are expanded
    with this function.

    The expand function is provided by Snakemake to generate lists of file paths
    based on the passed parameters. 

    Args:
        stage (str): The name of the stage.
        filename (str): The name of the file to be expanded.

    Returns:
        list[str]: A list of expanded paths.
    """
    # Every real stage's own rule nests its output one level deeper,
    # under a per-sample directory (JOB_DIR/stage/{sample}/filename) --
    # confirmed against every rule file's own output: block, not
    # assumed. Missing this nesting here meant `rule all` requested
    # paths no rule actually produced.
    return expand(str(JOB_DIR / stage / "{sample}" / filename), sample = SAMPLES)

def enabled_targets() -> list[str]:
    """
    This returns the configured list of final targets. The path to the targets (via the steps of
    the pipeline) are generated automatically by Snakemake.

    Args:
        None

    Returns:
        list[str]: A list of expanded paths.
    """
    # This function eventually returns this list of targets. 
    targets: list[str] = []

    # Each stage produces a "done" file which serves as a checkpoint for Snakemake to build the DAG.
    # In this way, we are making forcing a DAG of targets making debugging easier and enforcing step ordering.
    if stage_enabled("01-qc_raw"): 
        targets.extend(sample_target("qc/raw", "{sample}.qc_raw.done"))
    if stage_enabled("02-trimming"): 
        targets.extend(sample_target("trimming", "{sample}.trimming.done"))
    if stage_enabled("03-qc_trimmed"): 
        targets.extend(sample_target("qc/trimmed", "{sample}.qc_trimmed.done"))
    if stage_enabled("04a-getorganelle_config"): 
        targets.extend(sample_target("04a-getorganelle_config", "{sample}.getorganelle_config.done"))
    if stage_enabled("04c-seed_sequences"): 
        targets.extend(sample_target("04c-seed_sequences", "{sample}.seed_sequences.done"))
    if stage_enabled("04d-assembly"):
        targets.extend(sample_target("04d-assembly", "{sample}.assembly.done"))
    if stage_enabled("05a-blast_config"):
        targets.extend(sample_target("05a-blast_config", "{sample}.blast_config.done"))
    if stage_enabled("05b-blast"):
        targets.extend(sample_target("05b-blast", "{sample}.blast.done"))
    if stage_enabled("05c-blast_hits"):
        targets.extend(sample_target("05c-blast_hits", "{sample}.blast_hits.done"))
    if stage_enabled("06-contig_selection"):
        targets.extend(sample_target("06-contig_selection", "{sample}.contig_selection.done"))
        # biological_validation (#414) lives in the same rule file and
        # extends this same stage's selection -- requested here too, so
        # `rule all` actually triggers it, not just contig_selection itself.
        targets.extend(sample_target("06-contig_selection", "{sample}.biological_validation.done"))
    if stage_enabled("07-assembly_rescue"):
        targets.extend(sample_target("07-assembly_rescue", "{sample}.assembly_rescue.done"))
    if stage_enabled("08a-mitos2_config"):
        targets.extend(sample_target("08a-mitos2_config", "{sample}.mitos2_config.done"))
    if stage_enabled("08b-annotation"):
        targets.extend(sample_target("08b-annotation", "{sample}.annotation.done"))
    if stage_enabled("09-visualization"):
        targets.extend(sample_target("09-visualization", "{sample}.visualization.done"))
    # Restored to v0.1.0's own per-sample design: each sample's own
    # phylogenetic dataset/alignment/tree is built from its own
    # assembled genome plus its own live-fetched BLAST references --
    # never a single batch-level artifact, so a sample's tree never
    # depends on how many other samples are in the same run.
    if stage_enabled("10-alignment_dataset"):
        targets.extend(sample_target("10-alignment_dataset", "{sample}.phylogeny_dataset.done"))
    if stage_enabled("11-phylogeny"):
        targets.extend(sample_target("11-phylogeny", "{sample}.phylogeny.done"))
        targets.extend(sample_target("11-phylogeny", "{sample}.tree_figure.done"))
    if stage_enabled("12a-stats_aggregation"):
        targets.extend(sample_target("12a-stats_aggregation", "{sample}.stats_aggregation.done"))
    # Data aggregation is a job-level artifact (one consolidated
    # aggregated_data/ tree per run, covering every sample), never
    # per-sample -- a single job-level target, not sample_target()'s
    # per-sample expansion.
    if stage_enabled("12b-data_aggregation"):
        targets.append(str(JOB_DIR / "aggregated_data" / "data_aggregation.done"))
    if stage_enabled("13-report_pdf"):
        targets.extend(sample_target("13-report_pdf", "{sample}.report_pdf.done"))
        # The run-level report (#360) is a single job-level artifact
        # aggregating every sample, the same batch-level pattern as
        # #10/#11's own job-level targets above.
        targets.append(str(JOB_DIR / "13-report_pdf" / "run_report.done"))
    # #367-369's SRA/BioSample metadata tables are genuinely job-level
    # artifacts (one table covering every sample, built in a single
    # call, the same real v0.1.0 design) -- job-level targets, not
    # sample_target()'s per-sample expansion. #370's GenBank
    # submission folder is genuinely per-sample (each one depends
    # only on that sample's own selected assembly/annotation).
    if stage_enabled("14a-sra_archival"):
        targets.append(str(JOB_DIR / "14a-sra_archival" / "sra_archival.done"))
    if stage_enabled("14b-biosample_archival"):
        targets.append(str(JOB_DIR / "14b-biosample_archival" / "biosample_archival.done"))
    if stage_enabled("14c-mitogenome_archival"):
        targets.extend(sample_target("14c-mitogenome_archival", "{sample}.mitogenome_archival.done"))
    if stage_enabled("15-archival_validation"):
        targets.append(str(JOB_DIR / "15-archival_validation" / "archival_validation.done"))
    if stage_enabled("16-table2asn_validation"):
        targets.extend(sample_target("16-table2asn_validation", "{sample}.table2asn_validation.done"))
    
    # Returning the list of targets.
    return targets

# The rule to rule all rules as it were - this rule executes to ensure that the DAG is constructed correctly.
# Each individual rule is defined in a separate file and expects its own inputs and outputs. 
rule all: 
    input: 
        enabled_targets()

# These essentially append the rules defined in the other files to the Snakefile. 
include: "rules/01-qc_raw.smk"
include: "rules/02-trimming.smk"
include: "rules/03-qc_trimmed.smk"
include: "rules/04a-getorganelle_config.smk"
include: "rules/04c-seed_sequences.smk"
include: "rules/04d-assembly.smk"
include: "rules/05a-blast_config.smk"
include: "rules/05b-blast.smk"
include: "rules/05c-blast_hits.smk"
include: "rules/06-contig_selection.smk"
include: "rules/07-assembly_rescue.smk"
include: "rules/08a-mitos2_config.smk"
include: "rules/08b-annotation.smk"
# Every rule file is included unconditionally -- confirmed by a real
# failure that Snakemake's own `include:` directive is resolved at
# PARSE time, not runtime, so wrapping it in `if stage_enabled(...):`
# silently never includes the file at all, even when the stage really
# is enabled (the rules just don't exist; no error, no warning).
# stage_enabled() still correctly gates what rule all actually
# requests (see enabled_targets() above) -- that's the real on/off
# switch. A stage not yet built (archival/validation, 14a-16) gets a
# placeholder rule file with no real rules, so an unconditional
# include never fails to parse regardless of build progress.
include: "rules/09-visualization.smk"
include: "rules/10-alignment_dataset.smk"
include: "rules/11-phylogeny.smk"
include: "rules/12a-stats_aggregation.smk"
include: "rules/12b-data_aggregation.smk"
include: "rules/13-report_pdf.smk"
include: "rules/14a-sra_archival.smk"
include: "rules/14b-biosample_archival.smk"
include: "rules/14c-mitogenome_archival.smk"
include: "rules/15-archival_validation.smk"
include: "rules/16-table2asn_validation.smk"
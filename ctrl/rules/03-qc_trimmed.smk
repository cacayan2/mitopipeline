"""
03-qc_trimmed.smk

Executes and validates FastQC on trimmed data.
"""

# Imports
from pathlib import Path

# To make things easier, we'll subset the portion of the config related to GetOrganelle.
QC_TRIMMED_CONFIG = config["stage_options"]["qc.trimmed"]["fastqc"]

rule qc_trimmed:
    # When the pipeline is run, a runtime manifest is generated.
    # While a passed manifest includes relative paths for both r1 and
    # r2 files, the runtime manifest generates absolute paths for both r1
    # and r2.
    #
    # wc.sample is imputed by information from {sample}, and {sample}
    # is ultimately derived from ctrl/Snakefile under the sample_target function.
    # The sample_target() function returns a list of strings containing the required targets
    # of a given step.
    #
    # Remember: This file is a sequential extension of ctrl/Snakefile, so variables defined there
    # are also in scope for this rule. Because this depends on 2-trimming.smk to be completed, it looks for the
    # corresponding .done file as an input.
    #
    # Args:
    #     r1: The hard-coded path for the trimmed r1 file, taken from the runtime manifest.
    #     r2: The hard-coded path for the trimmed r2 file, taken from the runtime manifest.
    #     trimming_done: The hard-coded path for the trimming.done file.
    #
    # (A bare string literal here is NOT valid Snakemake syntax under the
    # version this project resolves to -- see 01-qc_raw.smk's note.)
    input:
        # Matches 02-trimming.smk's actual output names exactly.
        r1 = str(JOB_DIR / "trimming" / "{sample}" / "{sample}.R1.trimmed.fastq.gz"),
        r2 = str(JOB_DIR / "trimming" / "{sample}" / "{sample}.R2.trimmed.fastq.gz"),
        trimming_done = str(JOB_DIR / "trimming" / "{sample}" / "{sample}.trimming.done")
    # This is where the imputation logic for this rule begins. We explicitly define each of the files
    # required to be generated for this step of the pipeline. A .done file is generated by each step -
    # this used as a hook for subsequent steps (subsequent steps will be looking for the .done file
    # as a target).
    #
    # Args:
    #     r1_html: The absolute path for the r1 .html file generated by fastqc.
    #     r1_zip: The absolute path for the r1 .zip file generated by fastqc.
    #     r2_html: The absolute path for the r2 .html file generated by fastqc.
    #     r2_zip: The absolute path for the r2 .zip file generated by fastqc.
    #     done: The absolute path for the .done file generated.
    output:
        # The {sample} prefix is deliberate and required on every stage's
        # output (Emil's call, 2026-10-21) -- see 01-qc_raw.smk's note.
        r1_html = str(JOB_DIR / "qc" / "trimmed" / "{sample}" / "{sample}.R1_fastqc.html"),
        r1_zip = str(JOB_DIR / "qc" / "trimmed" / "{sample}" / "{sample}.R1_fastqc.zip"),
        r2_html = str(JOB_DIR / "qc" / "trimmed" / "{sample}" / "{sample}.R2_fastqc.html"),
        r2_zip = str(JOB_DIR / "qc" / "trimmed" / "{sample}" / "{sample}.R2_fastqc.zip"),
        done = str(JOB_DIR / "qc" / "trimmed" / "{sample}" / "{sample}.qc_trimmed.done")
    # The shell runs a python script that has options - params defines
    # those options.
    #
    # Args:
    #     output_dir: The output directory for fastqc analysis.
    #     working_dir: The current working directory of the mitopipeline.
    #     log_file: The location of the log file for this portion of the pipeline.
    #     global_log_file: The pipeline-wide log file every stage also writes to.
    #     metrics_dir: Where to persist this run's compute metrics (CPU/memory/runtime) as JSON.
    #     exec_script: The exec-layer script's own file path -- invoked
    #         by path, not `python -m` (see 01-qc_raw.smk for why).
    params:
        output_dir = str(JOB_DIR / "qc" / "trimmed" / "{sample}"),
        working_dir = str(Path.cwd()),
        log_file = str(JOB_DIR / "logs" / "qc" / "trimmed" / "{sample}.qc_trimmed.log"),
        global_log_file = str(GLOBAL_LOG_FILE),
        metrics_dir = str(JOB_DIR / "metrics" / "qc" / "trimmed" / "{sample}"),
        exec_script = str(SRC_DIR / "mitopipeline" / "exec" / "03-qc_trimmed" / "run_fastqc_trimmed.py")
    threads:
        QC_TRIMMED_CONFIG.get("threads")
    conda:
        "../../envs/01-qc.yaml"
    shell:
        """
        python {params.exec_script:q} \
            --sample-id {wildcards.sample} \
            --r1 {input.r1:q} \
            --r2 {input.r2:q} \
            --output-dir {params.output_dir:q} \
            --working-dir {params.working_dir:q} \
            --log-file {params.log_file:q} \
            --global-log-file {params.global_log_file:q} \
            --metrics-dir {params.metrics_dir:q} \
            --threads {threads}

        test -s {output.r1_html:q}
        test -s {output.r1_zip:q}
        test -s {output.r2_html:q}
        test -s {output.r2_zip:q}
        touch {output.done:q}
        """
